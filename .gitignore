# --- TEMP / EDITOR FILES ---
*.tmp
*.temp
*.swp
*.bak
*.lock
temp_*.lock
# Wheelhouse (offline dependencies)
.wheelhouse/

# Generated data files (do not commit)
filtr/data/**

# Local build log (Windows Task Scheduler / dev)
feed_build.log

# Python cache
__pycache__/
*.py[cod]

# Python test cache
.pytest_cache/

# Virtual environments
.venv/
venv/

# IDE (allow workspace settings for OOM prevention)
.vscode/*
!.vscode/settings.json
.idea/
.cursorignore

# OS
.DS_Store
Thumbs.db

# allow CI generated data
!filtr/data/weather.json
!filtr/data/namedays.json

# Local evidence dumps (do not commit)
tmp/_gitattributes_head.txt

# Local CDP/Edge profiles (do not commit)
tmp/cdp-edge-profile-*/

# Local prod screenshots
prod-*.png

# Health report outputs (CI uploads as artifact)
reports/
reports-download/

# Local nightly test outputs
_nightly_test/

# Local prod verify scripts (keep locally, do not commit)
tools/verify-ai-close-x.mjs
tools/verify-ai-close-x-prod.mjs

# Local artifacts
tools/_artifacts_ai_close_x/
tools/_artifacts/

# infoUzel: never track artifacts/proofs
artifacts/

# infoUzel: article pipeline staging (ephemeral; never commit)
projects/data/staging/

# Silver autopilot: local timeout artifact archives (never commit)
.silver-runtime/

# Pipeline handoff checkout (local; never commit on main — CI uses git add -f on handoff branch)
/pipeline-handoff/

# infoUzel: generated monitoring (never commit)
projects/data/fetch_monitor.json
projects/data/feed_snapshots/
projects/data/feed_transport_state.json
projects/data/section_release_state.json

# Fast pool / ingest runtime caches (never commit)
projects/data/robots_cache.json
iu_content_freshness_guard_report.json
scripts/*-guard-report.json
scripts/*-guard-v1-report.json

# Silver retrieval stress 300k local JSON exports (runtime; never commit large artifacts)
scripts/silver-retrieval-stress-300k-export*.json

# Node (vendor libs in assets/vendor; do not track node_modules)
node_modules/

# CHMI CAP v2: local shadow-run audit dumps (written to %TEMP%; ignore if recreated under fixtures)
scripts/fixtures/chmi-cap-v2/_shadow_out/*.json

# NDIC DATEX v1: full TMC table + raw pull cache (licence — never publish / commit)
.cache/ndic-datex-v1/
projects/data/info_events/ndic_datex_v1/tmc_store.json
# Persistent TMC LKG must never be committed (licensed points).
.cache/ndic-datex-v1/tmc-lkg/
projects/data/info_events/ndic_datex_v1/raw/
