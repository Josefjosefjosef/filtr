{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infouzel.cz/schemas/iu-ndic-shadow-forensic-summary-v1.json",
  "title": "iu-ndic-shadow-forensic-summary-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "RUN_ID",
    "HEAD_SHA",
    "MODE",
    "STARTED_AT",
    "FINISHED_AT",
    "OK",
    "REASON",
    "DATEX_HTTP_STATUS_CLASS",
    "DATEX_CONTENT_TYPE_VALID",
    "DATEX_BYTES_READ",
    "DATEX_XML_PARSE_PASS",
    "TMC_ARCHIVE_USED",
    "TMC_VERSION",
    "TMC_RESOLVER_VERSION",
    "LOADED_EVENTS",
    "ACTIVE_EVENTS",
    "FUTURE_EVENTS",
    "ENDED_EVENTS",
    "REJECTED_EVENTS",
    "RESOLVED_BASIC",
    "UNRESOLVED",
    "DUPLICATES_DETECTED",
    "DEDUPLICATED_EVENTS",
    "NORMALIZED_EVENTS",
    "AGGREGATED_EVENTS",
    "DIFF_NEW",
    "DIFF_CHANGED",
    "DIFF_ENDED",
    "DIFF_CANCELLED",
    "PUBLICATION_ITEMS",
    "PUBLICATION_REJECTED",
    "FEED_ITEMS",
    "CARD_PREVIEW_COUNT",
    "CARD_VALIDATION_PASS",
    "PROVENANCE_FIELDS_VALID",
    "PROVENANCE_FIELDS_MISSING",
    "PROVENANCE_REJECTED",
    "SOURCE_TIME_VALID",
    "SOURCE_TIME_MISSING",
    "UNVERIFIED_KM_PUBLISHED",
    "UNVERIFIED_DIRECTION_PUBLISHED",
    "UNVERIFIED_LOCATION_PUBLISHED",
    "FUZZY_MATCH_USED",
    "GEOCODING_USED",
    "HEURISTIC_LOCATION_USED",
    "PUBLICATION_ENABLED",
    "PUBLISHED",
    "SHADOW_ISOLATED",
    "MAX_CARD_PREVIEW_ITEMS"
  ],
  "properties": {
    "schema": { "type": "string", "const": "iu-ndic-shadow-forensic-summary-v1", "maxLength": 64 },
    "RUN_ID": { "type": "string", "minLength": 1, "maxLength": 80 },
    "HEAD_SHA": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "MODE": { "type": "string", "enum": ["shadow", "off", "active"] },
    "STARTED_AT": { "type": "string", "maxLength": 40, "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "FINISHED_AT": { "type": "string", "maxLength": 40, "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "OK": { "type": "boolean" },
    "REASON": { "type": "string", "maxLength": 120 },
    "DATEX_HTTP_STATUS_CLASS": { "type": "string", "enum": ["2xx", "3xx", "4xx", "5xx", "none", "unknown"] },
    "DATEX_CONTENT_TYPE_VALID": { "type": "boolean" },
    "DATEX_BYTES_READ": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DATEX_XML_PARSE_PASS": { "type": "boolean" },
    "TMC_ARCHIVE_USED": { "type": "boolean" },
    "TMC_VERSION": { "type": "string", "maxLength": 64 },
    "TMC_RESOLVER_VERSION": { "type": "string", "maxLength": 64 },
    "LOADED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "ACTIVE_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "FUTURE_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "ENDED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "REJECTED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "RESOLVED_BASIC": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "UNRESOLVED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DUPLICATES_DETECTED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DEDUPLICATED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "NORMALIZED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "AGGREGATED_EVENTS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DIFF_NEW": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DIFF_CHANGED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DIFF_ENDED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "DIFF_CANCELLED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "PUBLICATION_ITEMS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "PUBLICATION_REJECTED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "FEED_ITEMS": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "CARD_PREVIEW_COUNT": { "type": "integer", "minimum": 0, "maximum": 20 },
    "CARD_VALIDATION_PASS": { "type": "boolean" },
    "PROVENANCE_FIELDS_VALID": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "PROVENANCE_FIELDS_MISSING": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "PROVENANCE_REJECTED": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "SOURCE_TIME_VALID": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "SOURCE_TIME_MISSING": { "type": "integer", "minimum": 0, "maximum": 50000000 },
    "UNVERIFIED_KM_PUBLISHED": { "type": "integer", "const": 0 },
    "UNVERIFIED_DIRECTION_PUBLISHED": { "type": "integer", "const": 0 },
    "UNVERIFIED_LOCATION_PUBLISHED": { "type": "integer", "const": 0 },
    "FUZZY_MATCH_USED": { "type": "boolean", "const": false },
    "GEOCODING_USED": { "type": "boolean" },
    "HEURISTIC_LOCATION_USED": { "type": "boolean", "const": false },
    "PUBLICATION_ENABLED": { "type": "boolean", "const": false },
    "PUBLISHED": { "type": "boolean", "const": false },
    "SHADOW_ISOLATED": { "type": "boolean" },
    "MAX_CARD_PREVIEW_ITEMS": { "type": "integer", "const": 20 }
  }
}
