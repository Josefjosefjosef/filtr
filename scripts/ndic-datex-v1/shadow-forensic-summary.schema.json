{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infouzel.cz/schemas/iu-ndic-shadow-forensic-summary-v2.json",
  "title": "iu-ndic-shadow-forensic-summary-v2",
  "type": "object",
  "additionalProperties": false,
  "description": "PUBLICATION_ITEMS equals PUBLICATION_PROJECTIONS_TOTAL (internal gate projections). PUBLICATION_ELIGIBLE_TOTAL requires verified location trust + provenance. Unresolved location is never publicly precise.",
  "required": [
    "schema",
    "RUN_ID",
    "HEAD_SHA",
    "MODE",
    "PUBLICATION_PROJECTIONS_TOTAL",
    "PUBLICATION_ELIGIBLE_TOTAL",
    "PUBLICATION_BLOCKED_TOTAL",
    "RESOLVED_BASIC",
    "UNRESOLVED_TOTAL",
    "UNVERIFIED_KM_PUBLISHED",
    "UNVERIFIED_DIRECTION_PUBLISHED",
    "UNVERIFIED_LOCATION_PUBLISHED",
    "PUBLICATION_ENABLED",
    "PUBLISHED",
    "CARD_PROJECTION_VALIDATION_PASS",
    "CARD_PUBLICATION_ELIGIBILITY_PASS",
    "CARD_LOCATION_VALIDATION_PASS",
    "MAX_CARD_PREVIEW_ITEMS"
  ],
  "properties": {
    "schema": { "type": "string", "const": "iu-ndic-shadow-forensic-summary-v2" },
    "DATEX_BYTES_READ": { "type": "integer", "minimum": 0, "maximum": 512000000 },
    "PUBLICATION_ITEMS": { "type": "integer", "minimum": 0 },
    "PUBLICATION_PROJECTIONS_TOTAL": { "type": "integer", "minimum": 0 },
    "PUBLICATION_ELIGIBLE_TOTAL": { "type": "integer", "minimum": 0 },
    "PUBLICATION_BLOCKED_TOTAL": { "type": "integer", "minimum": 0 },
    "UNVERIFIED_KM_PUBLISHED": { "type": "integer", "const": 0 },
    "UNVERIFIED_DIRECTION_PUBLISHED": { "type": "integer", "const": 0 },
    "UNVERIFIED_LOCATION_PUBLISHED": { "type": "integer", "const": 0 },
    "FUZZY_MATCH_USED": { "type": "boolean", "const": false },
    "HEURISTIC_LOCATION_USED": { "type": "boolean", "const": false },
    "PUBLICATION_ENABLED": { "type": "boolean", "const": false },
    "PUBLISHED": { "type": "boolean", "const": false },
    "MAX_CARD_PREVIEW_ITEMS": { "type": "integer", "const": 20 }
  }
}
