sectionKey":"aff-dilna-naradi","partnerLogoUrl":null,"title":"Expondo CZ Black Friday 2026","couponCode":null,"conditionsSummary":"Expondo CZ Black Friday 2026","validFrom":"2026-11-08 23:00:00.0","validTo":"2026-12-05 23:00:00.0","targetedCountries":"CZ","affiliateUrl":"https://www.jdoqocy.com/click-101883843-17388140-1794611039000","publicationReady":true,"publishable":true,"blockers":[],"sourceSystem":"cj_link_search_staging","fixtureOnly":false,"sectionKeys":["aff-dilna-naradi"],"lastCheckedAt":null,"fetchedAt":null,"freshnessStatus":"SOURCE_FRESH","freshnessReason":"within_window","validityStatus":"BOUNDED"},{"kind":"action","offerId":"17388139","partnerName":"Expondo GMBH","partnerSlug":null,"advertiserId":"5320945","sectionKey":"aff-dilna-naradi","partnerLogoUrl":null,"title":"Expondo CZ Black Week 2026","couponCode":null,"conditionsSummary":"Expondo CZ Black Week 2026","validFrom":"2026-11-08 23:00:00.0","validTo":"2026-12-05 23:00:00.0","targetedCountries":"CZ","affiliateUrl":"https://www.dpbolvw.net/click-101883843-17388139-1794611039000","publicationReady":true,"publishable":true,"blockers":[],"sourceSystem":"cj_link_search_staging","fixtureOnly":false,"sectionKeys":["aff-dilna-naradi"],"lastCheckedAt":null,"fetchedAt":null,"freshnessStatus":"SOURCE_FRESH","freshnessReason":"within_window","validityStatus":"BOUNDED"}],"products":[{"productId":"EX10011681","productVariant":null,"brand":null,"title":"Mueble Neutro de Acero Inoxidable ECO 150 x 60 cm 600 kg Royal Catering - Muebles Neutros by","description":"Ya sea en restaurantes, comedores, hoteles, confiterías, hospitales o grandes cocinas: Los muebles de acero inoxidable son la base para una cocina limpia y un procesamiento de alimentos higiénico. El armario bajo de acero inoxidable RCSSCB-150x60-E de Royal Catering, el experto en equipamiento de hostelería de alta calidad, no debe faltar en cocinas profesionales y ha sido concebido especialmente para cumplir con los requisitos del sector gastronómico.&nbsp;La superficie de trabajo de este moderno mueble de cocina en acero inoxidable tiene unas dimensiones de 150 x 60 cm y ofrece gran cantidad de espacio para la manipulación de alimentos frescos, ingredientes y aparatos de cocina. La inteligente combinación de superficie de trabajo y armario de almacenamiento posibilita un empleo versátil, a la vez que ayuda a mantener el orden en la cocina. Dotado de dos prácticas puertas correderas, que ayudan a ahorrar espacio en la cocina, el mueble resulta muy práctico sobre todo en espacios reducidos. Los utensilios colocados en el interior se almacenan de manera segura y limpia protegidos por las puertas correderas de deslizamiento suave.&nbsp;El espacio interior está separado por un firme estante, lo que garantiza una configuración clara. Al igual que la superficie inferior y la de trabajo, puede soportar una carga de hasta 200 kg. De esta forma, el armario bajo para cocina presenta una enorme capacidad de carga total de hasta 600 kg. La mesa de trabajo para cocina, fabricada en acero inoxidable y con una altura de 85 cm, consigue una estabilidad óptima incluso en suelos irregulares gracias a sus cuatro pies regulables en altura.&nbsp;El acero inoxidable de alta calidad sobresale por su alta resistencia, garantiza una larga vida útil y es resistente a corrosión y daños mecánicos (por ejemplo, arañazos). El material es fácil de limpiar, por lo que resulta perfecto para llevar a cabo un trabajo higiénico con alimentos. Este elegante mueble de cocina se arma sin complicaciones gracias a las instrucciones de montaje claras.","imageUrl":"https://assets.expondo.com/asset/product_photos/10011681_photo_1","currentPrice":"286.00","originalPrice":null,"currency":"EUR","discountLabel":null,"savingsLabel":null,"validTo":null,"affiliateUrl":"https://www.tkqlhce.com/click-101883843-14009599?url=https%3A%2F%2Fwww.expondo.es%2Froyal-catering-mueble-neutro-en-acero-inoxidable-150-x-60-x-85-cm-600-kg-de-capacidad-de-carga-10011681%3Futm_sour