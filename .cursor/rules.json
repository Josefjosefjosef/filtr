{
  "allow": [

    "git *",
    "gh *",

    "git status *",
    "git diff *",
    "git grep *",
    "git fetch *",
    "git pull *",
    "git push *",
    "git switch *",
    "git checkout *",
    "git stash *",
    "git log *",
    "git add *",
    "git commit *",
    "git merge *",
    "git branch *",

    "Set-Location *",
    "cd *",

    "$ErrorActionPreference=*",
    "$ErrorActionPreference *",
    "$ErrorActionPreference='*'",
    "$ErrorActionPreference=\"*\"",

    "pwsh *",
    "powershell *",
    "cmd *",

    "dir *",
    "ls *",
    "type *",
    "cat *",
    "echo *",
    "findstr *",
    "grep *",
    "curl *",
    "node *",
    "npm *",
    "python *",
    "pip *"
  ]
}
