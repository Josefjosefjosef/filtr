{
  "allow": [
    "git *",
    "gh *",
    "npm *",
    "node *",
    "python *",
    "pip *",
    "curl *",
    "Set-Location *",
    "$ErrorActionPreference=*",
    "$ErrorActionPreference *",
    "$ErrorActionPreference='*'",
    "$ErrorActionPreference=\"*\"",
    "pwsh *",
    "powershell *",
    "cmd *",
    "cd *",
    "ls *",
    "dir *",
    "type *",
    "cat *",
    "echo *",
    "findstr *",
    "grep *"
  ]
}
