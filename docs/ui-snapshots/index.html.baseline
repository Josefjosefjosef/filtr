    </div>
  </div>

  <!-- ✅ FALLBACK: Render optimizer (pokud se externí soubor nenačte) -->
  <script>
    (function(){
      if (window.__iuRenderOptimizer && typeof window.__iuRenderOptimizer.renderChunked === "function") {
        return;
      }

      const DEFAULT_CHUNK = 25;
      const DEFAULT_DOM_LIMIT = 400;

      function renderChunked(renderSingleItem, totalCount, targetEl, opts){
        const options = opts || {};
        const chunkSize = Number(options.chunkSize) > 0 ? Number(options.chunkSize) : DEFAULT_CHUNK;
        const cancelToken = options.cancelToken || { cancelled: false };

        let rendered = 0;
        let rafId = 0;

        function step(){
          if (cancelToken.cancelled) {
            try { options.onComplete && options.onComplete(rendered); } catch(_){}
            return;
          }

          const frag = document.createDocumentFragment();
          let n = 0;

          while(n < chunkSize && rendered < totalCount){
            if (cancelToken.cancelled) break;

            let node = null;
            try{
              node = renderSingleItem(rendered);
            }catch(_){
              node = null;
            }

            if (node) frag.appendChild(node);
            rendered += 1;
            n += 1;
          }

          if (frag.childNodes.length) {
            targetEl.appendChild(frag);
          }

          try { options.onProgress && options.onProgress(rendered, totalCount); } catch(_){}

          if (rendered < totalCount && !cancelToken.cancelled){
            rafId = requestAnimationFrame(step);
          }else{
            try { options.onComplete && options.onComplete(rendered); } catch(_){}
          }
        }

        rafId = requestAnimationFrame(step);

        return {
          cancel(){
            cancelToken.cancelled = true;
            try { if (rafId) cancelAnimationFrame(rafId); } catch(_){}
          }
        };
      }

      function enforceDOMLimit(listEl, limit){
        const max = Number(limit) > 0 ? Number(limit) : DEFAULT_DOM_LIMIT;
        if(!listEl) return;

        while(listEl.childNodes.length > max){
          listEl.removeChild(listEl.firstChild);
        }
      }

      window.__iuRenderOptimizer = {
        RENDER_CHUNK_SIZE: DEFAULT_CHUNK,
        DOM_LIMIT: DEFAULT_DOM_LIMIT,
        renderChunked,
        enforceDOMLimit
      };
    })();
  </script>

  <script src="assets/app-render-optimizer.js"></script>
  <script src="assets/app.js"></script>
</body>
</html>
